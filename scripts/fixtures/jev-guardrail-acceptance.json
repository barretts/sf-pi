      "pair": "shell",
      "role": "safe",
      "tool": "bash",
      "input": { "command": "git status --short" },
      "facts": {},
      "expected": "allow"
    },
    {
      "id": "jev-acceptance-01-risky",
      "pair": "shell",
      "role": "risky",
      "tool": "bash",
      "input": { "command": "git reset --hard" },
      "facts": {},
      "expected": "confirm"
    },
